# Copy to .env (git-ignored) and replace every value. Used by both docker-compose and the app.

# --- app secrets (read by patsquire_plr.config) ---
PLR__DATABASE__PASSWORD=change-me
PLR__OBJECT_STORAGE__ACCESS_KEY_ID=plr-minio
PLR__OBJECT_STORAGE__SECRET_ACCESS_KEY=change-me-too

# --- docker-compose service credentials (must match the values above) ---
POSTGRES_USER=plr
POSTGRES_DB=plr
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=plr-minio
MINIO_ROOT_PASSWORD=change-me-too
PLR_BUCKET=plr-artifacts

# --- host ports (must match config/settings.yaml; unusual values avoid clashing with
#     other local stacks on 5432/6379/9000) ---
PLR_POSTGRES_HOST_PORT=55432
PLR_REDIS_HOST_PORT=56379
PLR_MINIO_HOST_PORT=59000
PLR_MINIO_CONSOLE_HOST_PORT=59001
PLR_OLLAMA_HOST_PORT=11434

# --- model API keys, referenced by name from config/settings.yaml (models.backends.*.api_key_env)
# PLR_KEY_ANTHROPIC=
# PLR_KEY_OPENAI=
# PLR_KEY_GEMINI=
